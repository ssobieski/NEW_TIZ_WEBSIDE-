# Skopiuj do .env (nie commituj sekretów)

# Notion Internal Integration Token
# 1) https://www.notion.so/my-integrations → New integration
# 2) Udostępnij strony TIZ tej integracji (Share → Invite)
NOTION_TOKEN=secret_xxx

# Cloudflare R2 (S3 API)
CF_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
# opcjonalnie:
# CF_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# --- Dell 4×A100 przez Cybertech VPN ---
# Na Dellu: bash scripts/run_vllm_a100.sh
# Na kliencie / Cursor agent (host MUSI być w Cybertech VPN):
# VLLM_BASE_URL=http://200.0.0.110:8000
# MARKET_AGENTS_LLM_BASE_URL=http://200.0.0.110:8000
# VLLM_MODEL=Qwen/Qwen2.5-72B-Instruct-AWQ
# MARKET_AGENTS_LLM_API_KEY=EMPTY
# Fleet / remote:
# DELL_SSH=ssobieski@200.0.0.110
# DELL_FLEET_PATH=/home/ssobieski/NEW_TIZ_WEBSIDE-/data/fleet
# LOCAL_FLEET_PATH=data/fleet
# Agent remote SSH (Cursor secrets — NIE commituj):
# DELL_SSH_PRIVATE_KEY=<<PEM>>
# DELL_SSH_PUBLIC_KEY=ssh-ed25519 AAAA...
# Potem: bash scripts/setup_dell_ssh_from_secrets.sh
#        bash scripts/dell_remote.sh status
# Self-hosted Cursor worker: uruchom na Macu z VPN → agent ma trasę do 200.0.0.110
