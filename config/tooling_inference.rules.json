  "peer_rules": [
    {
      "id": "mold_peers_share_tooling",
      "when_product_family": ["injection_molds", "stamping_dies"],
      "or_vertical": ["mold_die"],
      "apply_tooling_from_family": "injection_molds",
      "rationale": "Firmy produkujące formy/matryce mają zbliżony zakres narzędzi i oprzyrządowania (HSM, EDM, deep-hole, ball-nose)."
    },
    {
      "id": "aerospace_iso_s_tooling",
      "when_product_family": ["aerospace_structurals"],
      "or_vertical": ["aerospace"],
      "apply_tooling_from_family": "aerospace_structurals",
      "rationale": "Peerzy aerospace zwykle potrzebują tooling pod ISO-S (tytan/Inconel) i 5-axis HSM."
    },
    {
      "id": "automotive_housings_peers",
      "when_product_family": ["housings", "gears"],
      "or_vertical": ["automotive"],
      "apply_tooling_from_family": "housings",
      "rationale": "Peerzy automotive (korpusy/przekładnie) dzielą boring, face milling, tapping, indexable drills."
    },
    {
      "id": "medical_micro_peers",
      "when_product_family": ["medical_implants"],
      "or_vertical": ["medical"],
      "apply_tooling_from_family": "medical_implants",
      "rationale": "Peerzy medyczni → mikro-narzędzia, Swiss, gwintowanie precyzyjne."
    },
    {
      "id": "castings_peers",
      "when_product_family": ["castings_machining"],
      "or_vertical": [],
      "apply_tooling_from_family": "castings_machining",
      "rationale": "Obróbka odlewów → face mills, boring, indexable drills; peerzy dzielą ten zakres."
    },
    {
      "id": "hydraulics_peers",
      "when_product_family": ["hydraulics_pneumatics"],
      "or_vertical": [],
      "apply_tooling_from_family": "hydraulics_pneumatics",
      "rationale": "Bloki hydrauliczne → deep-hole / gun drills, tapping, reaming."
    },
    {
      "id": "energy_large_peers",
      "when_product_family": ["energy_large_parts"],
      "or_vertical": ["energy"],
      "apply_tooling_from_family": "energy_large_parts",
      "rationale": "Peerzy energetyki → heavy turning, large boring, indexable drilling."
    }
